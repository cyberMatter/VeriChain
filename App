import { sealCard, verifyChain, quoteInSource } from "./ledger.js";

const $ = (id) => document.getElementById(id);
const STORE = "evidence-chain";
let chain = [];
try { chain = JSON.parse(localStorage.getItem(STORE) || "[]"); } catch { chain = []; }
const save = () => { try { localStorage.setItem(STORE, JSON.stringify(chain)); } catch { /* storage unavailable */ } };

function say(el, text, kind = "") { el.textContent = text; el.className = "msg " + kind; }
function el(tag, text, cls) {
  const node = document.createElement(tag);
  if (text !== undefined) node.textContent = text;
  if (cls) node.className = cls;
  return node;
}

function render() {
  const list = $("chain");
  list.replaceChildren();
  chain.forEach((c, i) => {
    const li = document.createElement("li");
    const head = el("div");
    head.append(el("span", c.status, "badge " + c.status), " ", el("code", "#" + c.hash.slice(0, 8)));
    const source = [c.author, c.title, c.published].filter(Boolean).join(" · ");
    li.append(head, el("strong", `${i + 1}. ${c.claim}`), el("blockquote", c.quote), el("small", source));
    list.append(li);
  });
  $("empty").hidden = chain.length > 0;
  $("headId").textContent = chain.length ? "#" + chain[chain.length - 1].hash.slice(0, 8) : "none yet";
}

function readForm() {
  return Object.fromEntries(["claim", "quote", "source", "author", "title", "url", "published"].map((k) => [k, $(k).value]));
}

$("check").addEventListener("click", () => {
  const { quote, source } = readForm();
  if (!quote.trim() || !source.trim()) return say($("sealMsg"), "Paste both a quote and the source text to check.", "bad");
  const r = quoteInSource(quote, source);
  r.ok ? say($("sealMsg"), "Quote found word for word in the source.", "ok")
       : say($("sealMsg"), `Not found in the source: "${r.missing}"`, "bad");
});

$("seal").addEventListener("click", async () => {
  const f = readForm();
  try {
    const card = await sealCard({ ...f, sourceText: f.source }, chain[chain.length - 1] ?? null);
    chain.push(card);
    save(); render();
    ["claim", "quote", "source", "author", "title", "url", "published"].forEach((k) => ($(k).value = ""));
    say($("sealMsg"), `Sealed as ${card.status}. Receipt #${card.hash.slice(0, 8)}.`, "ok");
  } catch (err) {
    say($("sealMsg"), err.message, "bad");
  }
});

$("download").addEventListener("click", () => {
  const blob = new Blob([JSON.stringify({ format: "evidence-chain/1", cards: chain }, null, 2)], { type: "application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "evidence-chain.json";
  a.click();
  URL.revokeObjectURL(a.href);
});

$("clear").addEventListener("click", () => {
  if (chain.length && confirm("Delete all cards from this browser?")) { chain = []; save(); render(); }
});

async function runVerify(text) {
  const list = $("verifyList");
  list.replaceChildren();
  let cards;
  try {
    const data = JSON.parse(text);
    cards = Array.isArray(data) ? data : data.cards;
    if (!Array.isArray(cards)) throw new Error();
  } catch { return say($("verifyMsg"), "That is not a valid chain file.", "bad"); }
  const { ok, results } = await verifyChain(cards);
  say($("verifyMsg"), ok ? "Chain intact: no card has been changed, removed or reordered." : "Chain BROKEN: see the failing card below.", ok ? "ok" : "bad");
  results.forEach((r) => {
    const li = el("li", `${r.ok ? "✔" : "✘"} Card ${r.index + 1}  #${r.hash.slice(0, 8)}${r.reason ? " — " + r.reason : ""}`, r.ok ? "pass" : "fail");
    list.append(li);
  });
}

$("verify").addEventListener("click", () => runVerify($("verifyInput").value));
$("verifyFile").addEventListener("change", async (e) => {
  const file = e.target.files[0];
  if (file) { $("verifyInput").value = await file.text(); runVerify($("verifyInput").value); }
});
async function loadSample(path) {
  try {
    const res = await fetch(path);
    if (!res.ok) throw new Error();
    $("verifyInput").value = await res.text();
    runVerify($("verifyInput").value);
  } catch { say($("verifyMsg"), "Samples need the page to be served over http (for example GitHub Pages).", "bad"); }
}
$("sampleGood").addEventListener("click", () => loadSample("examples/example-chain.json"));
$("sampleBad").addEventListener("click", () => loadSample("examples/tampered-chain.json"));

render();
